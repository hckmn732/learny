              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "finishReason": {
                "default": "stop",
                "type": "string",
                "enum": [
                  "stop",
                  "length",
                  "refusal"
                ]
              },
              "usage": {
                "default": {
                  "inputTokens": 0,
                  "outputTokens": 0,
                  "cacheReadTokens": 0,
                  "cacheWriteTokens": 0
