                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cacheWriteTokens": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "inputTokens",
                  "outputTokens",
                  "cacheReadTokens",
                  "cacheWriteTokens"
                ],
                "additionalProperties": false
              },
              "latencyMs": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "text",
              "finishReason",
              "usage",
              "latencyMs"
