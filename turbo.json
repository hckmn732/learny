{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.mjs", "tsconfig.base.json"],
  "globalPassThroughEnv": [
    "CI",
    "APP_ENV",
    "ENABLE_SDD_PAGES",
    "CLOCK_FIXED_AT",
    "LLM_MODE",
    "NODE_ENV",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:unit": {
      "cache": false
    },
    "test:int": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
