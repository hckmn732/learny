{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.mjs", "tsconfig.base.json"],
  "globalPassThroughEnv": [
    "CI",
    "APP_ENV",
    "ENABLE_SDD_PAGES",
    "CLOCK_FIXED_AT",
    "LLM_MODE",
    "NODE_ENV",
    "PORT",
    "INNGEST_DEV",
    "INNGEST_SIGNING_KEY",
    "INNGEST_SIGNING_KEY_FALLBACK",
    "INNGEST_EVENT_KEY",
    "API_INTERNAL_URL",
    "LEARNY_API_ROLE",
    "API_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "public/sw.js",
        "public/swe-worker-*.js",
        "public/swe-worker-build.txt"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    },
    "test:unit": {
      "cache": false
    },
    "test:int": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
