        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "fail": {
                    "enum": [
                      "business",
                      "crash"
                    ],
                    "type": "string"
                  },
                  "message": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "counter": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "receivedAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message",
                    "receivedAt",
                    "counter"
