      "post": {
        "operationId": "dev.uploadSimulation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "case": {
                    "enum": [
                      "pdf-limit",
                      "pdf-too-many-pages",
                      "image-limit",
                      "image-too-large",
                      "executable-as-png",
                      "note-too-long",
                      "chapter-full",
                      "quota-reached"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "case"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "accepted": {
                      "const": true,
                      "type": "boolean"
                    },
                    "case": {
                      "enum": [
                        "pdf-limit",
                        "pdf-too-many-pages",
                        "image-limit",
                        "image-too-large",
                        "executable-as-png",
                        "note-too-long",
                        "chapter-full",
                        "quota-reached"
                      ],
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "pdf",
                        "image"
                      ],
                      "type": "string"
                    },
                    "pages": {
                      "anyOf": [
                        {
                          "maximum": 9007199254740991,
                          "minimum": 1,
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sizeBytes": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "case",
                    "accepted",
                    "kind",
                    "sizeBytes",
                    "pages"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Succès"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Erreur (RFC 9457)"
