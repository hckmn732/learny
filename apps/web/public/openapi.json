    "/api/v1/auth/magic-link": {
      "post": {
        "operationId": "auth.magicLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "properties": {
                      "acceptedTerms": {
                        "const": true,
                        "type": "boolean"
                      },
                      "email": {
                        "type": "string"
                      },
                      "mode": {
                        "const": "sign-up",
                        "type": "string"
                      },
                      "timezone": {
                        "maxLength": 64,
                        "type": "string"
                      }
                    },
                    "required": [
                      "mode",
                      "email",
                      "acceptedTerms"
                    ],
                    "type": "object"
                  },
                  {
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "mode": {
                        "const": "sign-in",
                        "type": "string"
                      },
                      "next": {
                        "maxLength": 512,
                        "type": "string"
                      }
                    },
                    "required": [
                      "mode",
                      "email"
                    ],
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Succès"
