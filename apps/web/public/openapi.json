                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Erreur (RFC 9457)"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Réserve un apport fichier et renvoie une URL d’envoi signée de dix minutes (SPEC-206). La clé Idempotency-Key est obligatoire."
      }
