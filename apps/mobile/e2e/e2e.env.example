# Configuration de la campagne e2e mobile locale (SPEC-3001 EF-5, SPEC-3003 EF-9, ADR-3018).
# Copier en `apps/mobile/e2e/e2e.env` (fichier ignoré par Git) et renseigner les valeurs.
# Le build e2e (`pnpm build:mobile:e2e`) et le lanceur Maestro (`pnpm test:e2e:mobile`) lisent ce
# fichier ; une variable d'environnement a priorité sur lui.

# API, Supabase et web vus par l'émulateur local. `10.0.2.2` désigne la machine de l'émulateur :
# depuis ADR-3018 c'est la VM de développement elle-même, donc l'API et Supabase locaux. Ne pas
# mettre `127.0.0.1` ni `localhost` : l'émulateur ne les joint pas (le préflight le refuse).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<clé anonyme de la pile locale>
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3100

# SPEC-3003 EF-9 — compte de démonstration de la page `/_dev/sdd/SPEC-3003`. Le mot de passe est
# inliné dans le bundle e2e (`EXPO_PUBLIC_SDD_DEMO_PASSWORD`) et **jamais** affiché par la page.
# `MOBILE_DEMO_PASSWORD` est la source : `node apps/mobile/e2e/prepare-demo-user.mjs` l'applique au
# compte seedé, et le test d'intégration le lit.
EXPO_PUBLIC_SDD_DEMO_EMAIL=alex.perrin@demo.learny.test
EXPO_PUBLIC_SDD_DEMO_PASSWORD=learny-demo-3003
MOBILE_DEMO_EMAIL=alex.perrin@demo.learny.test
MOBILE_DEMO_PASSWORD=learny-demo-3003

# Émulateur local (ADR-3018) : AVD `learny`, démarrage à froid par `tools/dev/emulator-up.sh`.
# MOBILE_AVD=learny
# MOBILE_RECORD_VIDEO=1
# MOBILE_DISK_MIN_GB=4

# Le mode distant est retiré (ADR-3018) : MOBILE_DEVICE_AGENT_URL, MOBILE_DEVICE_AGENT_TOKEN,
# MOBILE_APK_URL et les identifiants Agent37 ne sont plus lus. Leur présence dans `e2e.env` fait
# échouer le préflight : les supprimer.
