# Configuration de la campagne e2e mobile (SPEC-3001 EF-5).
# Copier en `apps/mobile/e2e/e2e.env` (fichier ignoré par Git) et renseigner les valeurs.
# Le build e2e (`pnpm build:mobile:e2e`) et le lanceur Maestro (`pnpm test:e2e:mobile`) lisent ce
# fichier ; une variable d'environnement a priorité sur lui.

# API vue par l'émulateur. `10.0.2.2` désigne la machine de l'émulateur : sur cette plateforme à
# deux VM, publier le port 3001 de la VM de développement et mettre ici l'URL publique signée.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<clé anonyme de la pile locale>
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3100

# Appareil : `local` quand adb est sur cette machine, sinon l'agent appareil de la VM téléphone.
# MOBILE_DEVICE_AGENT_URL=https://<hash>.agent37.app
# MOBILE_DEVICE_AGENT_TOKEN=<jeton de l'agent>
# URL signée de l'APK, téléchargée par l'agent (mode distant uniquement).
# MOBILE_APK_URL=https://<hash>.agent37.app/app-release.apk
# MOBILE_AVD=agent37
# MOBILE_RECORD_VIDEO=1
