{# Common layout of every Learny e-mail (SPEC-204 ET-3, BR-NOT-08, ADR-0124): 600 px wide, page
   background #F4F4F1, white card with a 24 px radius and a #E7E6E1 border, no remote image and no
   tracking pixel. The footer always carries the "Gérer mes notifications" link and, for a service
   e-mail, the one-click unsubscribe link. #}
<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ preview }}</title>
</head>
<body style="margin:0;padding:32px 16px;background-color:#F4F4F1;font-family:'Inter','Helvetica Neue',Helvetica,Arial,sans-serif;color:#111113;font-size:15px;line-height:24px">
<div style="width:100%;max-width:600px;margin:0 auto;background-color:#FFFFFF;border:1px solid #E7E6E1;border-radius:24px;padding:32px">
<div>
<span data-testid="email-logo" aria-hidden="true" style="display:inline-block;width:32px;height:32px;border-radius:10px;background-color:#C6F432;vertical-align:middle"></span>
<span style="display:inline-block;margin-left:12px;font-family:'Space Grotesk',Arial,sans-serif;font-size:20px;font-weight:700;vertical-align:middle;color:#111113">Learny</span>
</div>
{% block content %}{% endblock %}
<hr style="border:0;border-top:1px solid #E7E6E1;margin:28px 0 20px">
<p style="margin:0 0 8px;font-size:13px;line-height:20px;color:#62626B">{{ footer }}</p>
<p style="margin:0 0 8px;font-size:13px;line-height:20px;color:#62626B"><a href="{{ preferences_url }}" style="color:#3A3AA8;text-decoration:underline" data-testid="email-preferences-link">{{ preferences_link }}</a>{% if unsubscribe_url %} · <a href="{{ unsubscribe_url }}" style="color:#3A3AA8;text-decoration:underline">{{ unsubscribe_link }}</a>{% endif %}</p>
</div>
</body>
</html>
