# =============================================================================
# Learny — variables d'environnement (modèle versionné, sans aucun secret)
# Copier en .env.local (développement) ; la validation est faite par
# packages/config (schéma Zod, SPEC-009). Les variables marquées [prod] sont
# obligatoires en production : l'application refuse de démarrer sans elles.
# Les valeurs ci-dessous sont celles du développement local (Supabase CLI,
# Mailpit, Inngest Dev Server) ou des placeholders vides. Les valeurs contenant
# « learny-test-only » sont des valeurs de développement publiques, refusées en
# production.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# local | test | preview | production
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clé maîtresse AES-256-GCM des clés IA personnelles (32 octets en base64) [prod]
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Ancienne clé maîtresse, conservée le temps d'une rotation (SPEC-505, facultative)
APP_ENCRYPTION_KEY_PREVIOUS=
LOG_LEVEL=info
# Renseignées par le build et le déploiement (SPEC-010) ; replis « dev » et « unknown » en local
APP_VERSION=
GIT_COMMIT=

# --- Sécurité de l'API (SPEC-208, ADR-0213) ---------------------------------
# Secret HMAC des adresses IP dans les clés de limitation de débit (≥ 32 caractères) [prod]
RATE_LIMIT_IP_SECRET=learny-test-only-rate-limit-ip-secret-0000
# true derrière un proxy de confiance (Vercel) : lit X-Forwarded-For ; false en local
TRUST_PROXY=false
# Origines supplémentaires autorisées pour les mutations, séparées par des virgules
ALLOWED_ORIGINS=

# --- Supabase (base, authentification, stockage) ----------------------------
# Valeurs affichées par `supabase start` en local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Taille du pool postgres.js (SPEC-101)
DATABASE_POOL_MAX=10
# Journal des requêtes Drizzle, développement uniquement (refusé en production)
DB_LOG_QUERIES=false

# --- IA (ADR-0018 à 0022, 0048) ---------------------------------------------
# mock | live  — `mock` obligatoire en test et en CI
LLM_MODE=mock
# Clé du fournisseur pour l'IA fournie (offre payante) [prod]
ANTHROPIC_API_KEY=
# Exécute les tests réels optionnels contre le fournisseur (0 | 1)
LLM_LIVE_TESTS=0
# Autorise les modèles locaux (Ollama, LM Studio) comme modèles personnels (SPEC-505)
ALLOW_LOCAL_MODELS=false
# Embeddings (ADR-0056) [prod]
VOYAGE_API_KEY=
EMBEDDING_DIM=1024
# Recherche web de repli pour les fournisseurs sans outil natif (Tavily, ADR-0048)
SEARCH_API_KEY=

# --- Jobs durables (Inngest, ADR-0017) --------------------------------------
# inngest | inline — `inline` exécute les jobs dans le processus (tests e2e, CI) ;
# interdit en production (ADR-0122)
JOBS_MODE=inngest
# Vides en local : le Dev Server (http://127.0.0.1:8288) n'en a pas besoin. [prod]
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# --- E-mails (Resend + React Email, ADR-0054) -------------------------------
# smtp (Mailpit en local) | memory (tests) | resend (preview/production)
EMAIL_MODE=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM="Learny <bonjour@learny.local>"
RESEND_API_KEY=
# Secret HMAC des liens de désinscription en un clic (≥ 32 caractères, ADR-0124) [prod]
EMAIL_LINK_SECRET=learny-test-only-email-link-secret-00000000
# Interface de Mailpit lue par les tests (SPEC-202, SPEC-204)
MAILPIT_URL=http://127.0.0.1:8025

# --- Notifications navigateur (Web Push VAPID, ADR-0055) --------------------
# Générer : npx web-push generate-vapid-keys [prod]
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@learny.local
# live | mock (les tests enregistrent les envois sans les émettre)
PUSH_MODE=mock

# --- Paiement (Stripe, ADR-0061) --------------------------------------------
# mock | test | live — `mock` en développement et en CI
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observabilité (ADR-0043) -----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Mentions légales (ADR-0045) — fournies par le porteur du projet [prod] --
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_HOST_NAME=
# Versions des CGU et de la politique de confidentialité (SPEC-806)
LEGAL_CGU_VERSION=2026-11-11
LEGAL_PRIVACY_VERSION=2026-11-11

# --- Tests et preuves SDD ---------------------------------------------------
# Horloge figée (ADR-0047) : vide = horloge réelle. En e2e : 2026-11-11T12:20:00Z
CLOCK_FIXED_AT=
# Pages de démonstration /_dev/sdd/[specId] et galeries /_dev/* (ADR-0049) ;
# seul `true` active le garde, et la production refuse le démarrage si ce n'est pas `false`.
ENABLE_SDD_PAGES=true
# Pousse sur origin après chaque fusion si le remote existe (ADR-0051) : 1 | 0
SDD_PUSH=1
# Outillage de test (hors schéma applicatif) : 1 = ne pas reconstruire avant les e2e (SPEC-004)
E2E_SKIP_BUILD=0
# 1 = active le projet Playwright « perf » (SPEC-804)
PW_PERF=0
# Chromium utilisé par Lighthouse ; vide = celui de Playwright (SPEC-804)
CHROME_PATH=

# --- Déploiement (SPEC-013) — secrets GitHub Actions, jamais dans un .env -----
# VERCEL_TOKEN, SUPABASE_ACCESS_TOKEN

# --- V2 ---------------------------------------------------------------------
# Transcription audio/vidéo (SPEC-901, SPEC-902)
DEEPGRAM_API_KEY=

# --- Auto-hébergement (SPEC-012) — copier dans .env.selfhost, jamais versionné ---------------
# `cp .env.example .env.selfhost`, remplir les valeurs vides ci-dessous puis suivre
# docs/operations/self-hosting.md. Les valeurs absentes des secrets obligatoires font échouer
# `docker compose config` avant tout démarrage (syntaxe `:?`).
# URLs publiques de cette installation (navigateur) — distinctes des valeurs locales ci-dessus :
LEARNY_PUBLIC_APP_URL=
LEARNY_PUBLIC_SUPABASE_URL=
# Ports publiés sur l'hôte (les autres services restent sur le réseau interne) :
LEARNY_WEB_PORT=8080
LEARNY_SUPABASE_PORT=8000
LEARNY_INNGEST_PORT=8288
LEARNY_MAILPIT_SMTP_PORT=1025
LEARNY_MAILPIT_UI_PORT=8025
# Mot de passe du rôle postgres et secret de signature des JWT Supabase (générés, vides ici) :
POSTGRES_PASSWORD=
SUPABASE_JWT_SECRET=
# Clés anon/service signées avec SUPABASE_JWT_SECRET (générées par tools/docker/selfhost-secrets.mjs) :
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Clés Inngest auto-hébergé (INNGEST_SIGNING_KEY : hexadécimal de longueur paire).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Secrets applicatifs obligatoires (générés) :
APP_ENCRYPTION_KEY=
RATE_LIMIT_IP_SECRET=
EMAIL_LINK_SECRET=
# Transport e-mail de production : remplacer mailpit par le SMTP réel avant exposition publique
# (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS). RESEND_API_KEY si EMAIL_MODE=resend.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ADMIN_EMAIL=bonjour@learny.example
SMTP_SENDER_NAME=Learny
# Identité du build, identiques pour web et worker (GIT_COMMIT=$(git rev-parse HEAD)).
GIT_COMMIT=
APP_VERSION=
