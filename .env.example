# =============================================================================
# Learny — variables d'environnement (modèle versionné, sans aucun secret)
# Copier en .env.local (développement) ; la validation est faite par
# packages/config (schéma Zod, SPEC-009). Les variables marquées [prod] sont
# obligatoires en production : l'application refuse de démarrer sans elles.
# Les valeurs ci-dessous sont celles du développement local (Supabase CLI,
# Mailpit, Inngest Dev Server) ou des placeholders vides. Les valeurs contenant
# « learny-test-only » sont des valeurs de développement publiques, refusées en
# production.
#
# Contrat du backend Python (ADR-2042, learny.shared.config.ENVIRONMENT_VARIABLES) :
# l'API et le worker Python ne lisent que APP_ENV, NEXT_PUBLIC_APP_URL, DATABASE_URL,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET, APP_ENCRYPTION_KEY, API_PROXY_SECRET, EMAIL_LINK_SECRET, EMAIL_FROM,
# RESEND_API_KEY, VAPID_PRIVATE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID,
# VOYAGE_API_KEY et SEARCH_API_KEY, plus les facultatives (rotation *_PREVIOUS, SMTP_HOST,
# ALLOW_LOCAL_MODELS, ENABLE_SDD_PAGES, CLOCK_FIXED_AT, GIT_COMMIT, APP_VERSION). Les modes
# (IA, Stripe, e-mail, push, jobs, limiteur) y sont dérivés d'APP_ENV et de CLOCK_FIXED_AT ;
# la clé de limitation de débit et la clé publique/le sujet VAPID sont dérivés. Les variables
# marquées [TS] ne sont lues que par le backend TypeScript et disparaissent avec SPEC-2302.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# local | test | preview | production
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clé maîtresse AES-256-GCM des clés IA personnelles (32 octets en base64) [prod]
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Ancienne clé maîtresse, conservée le temps d'une rotation (SPEC-505, facultative)
APP_ENCRYPTION_KEY_PREVIOUS=
# [TS] Le backend Python journalise toujours au niveau info.
LOG_LEVEL=info
# Renseignées par le build et le déploiement (SPEC-010) ; replis « dev » et « unknown » en local
APP_VERSION=
GIT_COMMIT=
# URL interne du backend Hono ; obligatoire en production (ADR-1002)
API_INTERNAL_URL=http://127.0.0.1:3001
# Secret partagé serveur entre apps/web et apps/api pour les en-têtes Forwarded (≥ 32 caractères)
API_PROXY_SECRET=learny-test-only-api-proxy-secret-value
# Ancien secret accepté temporairement par apps/api pendant une rotation (facultatif)
API_PROXY_SECRET_PREVIOUS=
# [TS] Rôle du processus backend : all | api | jobs
LEARNY_API_ROLE=all
# [TS] Port du backend autonome
API_PORT=3001

# --- Sécurité de l'API (SPEC-208, ADR-0213) ---------------------------------
# [TS] Secret HMAC des adresses IP dans les clés de limitation de débit (≥ 32 caractères) [prod]
# Python le dérive d'APP_ENCRYPTION_KEY (ADR-2042).
RATE_LIMIT_IP_SECRET=learny-test-only-rate-limit-ip-secret-0000
# [TS] true derrière un proxy de confiance (Vercel) : lit X-Forwarded-For ; false en local
TRUST_PROXY=false
# [TS] Origines supplémentaires autorisées pour les mutations, séparées par des virgules
ALLOWED_ORIGINS=

# --- Supabase (base, authentification, stockage) ----------------------------
# Valeurs affichées par `supabase start` en local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# [TS] URL JWKS des clés asymétriques ; Python la dérive de NEXT_PUBLIC_SUPABASE_URL
SUPABASE_JWKS_URL=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# [TS] Taille du pool postgres.js (SPEC-101) ; constante 5 côté Python
DATABASE_POOL_MAX=10
# [TS] Journal des requêtes Drizzle, développement uniquement (refusé en production)
DB_LOG_QUERIES=false

# --- IA (ADR-0018 à 0022, 0048) ---------------------------------------------
# [TS] mock | live  — `mock` obligatoire en test et en CI ; dérivé d'APP_ENV côté Python
LLM_MODE=mock
# [TS] Clé du fournisseur pour l'IA fournie (sans objet depuis SPEC-709)
ANTHROPIC_API_KEY=
# [TS] Exécute les tests réels optionnels contre le fournisseur (0 | 1)
LLM_LIVE_TESTS=0
# Autorise les modèles locaux (Ollama, LM Studio) comme modèles personnels (SPEC-505)
ALLOW_LOCAL_MODELS=false
# Embeddings (ADR-0056) [prod]
VOYAGE_API_KEY=
# [TS] Dimension des embeddings ; constante 1024 côté Python
EMBEDDING_DIM=1024
# Recherche web de repli pour les fournisseurs sans outil natif (Tavily, ADR-0048)
SEARCH_API_KEY=

# --- [TS] Jobs durables (Inngest, ADR-0017, retiré par ADR-2006) -------------
# Le worker Python n'a aucune variable : JOBS_MODE est dérivé (inline en e2e seulement).
# inngest | inline — `inline` exécute les jobs dans le processus (tests e2e, CI) ;
# interdit en production (ADR-0122)
JOBS_MODE=inngest
# Vides en local : le Dev Server (http://127.0.0.1:8288) n'en a pas besoin. [prod]
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# --- E-mails (Resend + React Email, ADR-0054) -------------------------------
# [TS] smtp (Mailpit en local) | memory (tests) | resend (preview/production) ;
# dérivé d'APP_ENV côté Python. SMTP_PORT est la constante 1025 côté Python.
EMAIL_MODE=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM="Learny <bonjour@learny.local>"
RESEND_API_KEY=
# Secret HMAC des liens de désinscription en un clic (≥ 32 caractères, ADR-0124) [prod]
EMAIL_LINK_SECRET=learny-test-only-email-link-secret-00000000
# [TS] Interface de Mailpit lue par les tests TypeScript (SPEC-202, SPEC-204)
MAILPIT_URL=http://127.0.0.1:8025

# --- Notifications navigateur (Web Push VAPID, ADR-0055) --------------------
# Générer : npx web-push generate-vapid-keys [prod]. Côté Python, la clé publique est dérivée
# de VAPID_PRIVATE_KEY et le sujet de l'adresse d'EMAIL_FROM ; le web lit la clé publique.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@learny.local
# [TS] live | mock (les tests enregistrent les envois sans les émettre) ; dérivé côté Python
PUSH_MODE=mock

# --- Paiement (Stripe, ADR-0061) --------------------------------------------
# [TS] STRIPE_MODE : mock | test | live — `mock` en développement et en CI ; dérivé côté Python
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observabilité (ADR-0043) -----------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Mentions légales (ADR-0045) — fournies par le porteur du projet [prod] --
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_HOST_NAME=
# Versions des CGU et de la politique de confidentialité (SPEC-806) ; constantes côté Python
LEGAL_CGU_VERSION=2026-11-11
LEGAL_PRIVACY_VERSION=2026-11-11

# --- Tests et preuves SDD ---------------------------------------------------
# Horloge figée (ADR-0047) : vide = horloge réelle. En e2e : 2026-11-11T12:20:00Z
CLOCK_FIXED_AT=
# Pages de démonstration /_dev/sdd/[specId] et galeries /_dev/* (ADR-0049) ;
# seul `true` active le garde, et la production refuse le démarrage si ce n'est pas `false`.
ENABLE_SDD_PAGES=true
# Pousse sur origin après chaque fusion si le remote existe (ADR-0051) : 1 | 0
SDD_PUSH=1
# Outillage de test (hors schéma applicatif) : 1 = ne pas reconstruire avant les e2e (SPEC-004)
E2E_SKIP_BUILD=0
# Chromium utilisé par Lighthouse ; vide = celui de Playwright (SPEC-804)
CHROME_PATH=

# --- Déploiement (SPEC-013) — secrets GitHub Actions, jamais dans un .env -----
# VERCEL_TOKEN, SUPABASE_ACCESS_TOKEN

# --- V2 ---------------------------------------------------------------------
# Transcription audio/vidéo (SPEC-901, SPEC-902)
DEEPGRAM_API_KEY=

# --- Auto-hébergement (SPEC-012) — copier dans .env.selfhost, jamais versionné ---------------
# `cp .env.example .env.selfhost`, remplir les valeurs vides ci-dessous puis suivre
# docs/operations/self-hosting.md. Les valeurs absentes des secrets obligatoires font échouer
# `docker compose config` avant tout démarrage (syntaxe `:?`).
# URLs publiques de cette installation (navigateur) — distinctes des valeurs locales ci-dessus :
LEARNY_PUBLIC_APP_URL=
LEARNY_PUBLIC_SUPABASE_URL=
# Ports publiés sur l'hôte (les autres services restent sur le réseau interne) :
LEARNY_WEB_PORT=8080
LEARNY_SUPABASE_PORT=8000
LEARNY_INNGEST_PORT=8288
LEARNY_MAILPIT_SMTP_PORT=1025
LEARNY_MAILPIT_UI_PORT=8025
# Mot de passe du rôle postgres et secret de signature des JWT Supabase (générés, vides ici) :
POSTGRES_PASSWORD=
SUPABASE_JWT_SECRET=
# Clés anon/service signées avec SUPABASE_JWT_SECRET (générées par tools/docker/selfhost-secrets.mjs) :
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Clés Inngest auto-hébergé (INNGEST_SIGNING_KEY : hexadécimal de longueur paire).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Secrets applicatifs obligatoires (générés) :
APP_ENCRYPTION_KEY=
RATE_LIMIT_IP_SECRET=
EMAIL_LINK_SECRET=
# Limiteur de débit : 'on' par défaut ; 'off' pour la pile de QA à horloge figée seulement,
# refusé en production (les seaux ne se rechargent jamais quand l'horloge est figée).
RATE_LIMIT_MODE=on
# Transport e-mail de production : remplacer mailpit par le SMTP réel avant exposition publique
# (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS). RESEND_API_KEY si EMAIL_MODE=resend.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ADMIN_EMAIL=bonjour@learny.example
SMTP_SENDER_NAME=Learny
# Identité du build, identique pour web et API (GIT_COMMIT=$(git rev-parse HEAD)).
GIT_COMMIT=
APP_VERSION=
