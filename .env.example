# =============================================================================
# Learny — variables d'environnement (modèle versionné, sans aucun secret)
# Copier en .env.local (développement) ; la validation Python est faite par
# learny.shared.config (ADR-2042) et le web garde son schéma (packages/config).
# Les variables marquées [prod] sont obligatoires en production : l'application
# refuse de démarrer sans elles. Les valeurs ci-dessous sont celles du
# développement local (Supabase CLI, Mailpit) ou des placeholders vides. Les
# valeurs contenant « learny-test-only » sont des valeurs de développement
# publiques, refusées en production.
#
# Contrat minimal (ADR-4007) : les modes (IA, Stripe, e-mail, push, jobs,
# limiteur) sont dérivés d'APP_ENV et de CLOCK_FIXED_AT ; les secrets internes
# (relais web vers API, liens e-mail, paire VAPID, clé du limiteur) sont des
# sous-clés HMAC d'APP_ENCRYPTION_KEY ; l'identité légale et les versions des
# documents sont des constantes du code (packages/config/src/product.ts).
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# local | test | preview | production
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clé maîtresse AES-256-GCM (32 octets en base64) dont dérivent les secrets internes [prod]
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# La changer invalide les liens e-mail et impose de renouveler les abonnements push.
APP_ENCRYPTION_KEY=
# Ancienne clé maîtresse, conservée le temps d'une rotation (SPEC-505, facultative)
APP_ENCRYPTION_KEY_PREVIOUS=
# Niveau des journaux du web (packages/core) : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Renseignées par le build et le déploiement (SPEC-010) ; replis « dev » et « unknown » en local
APP_VERSION=
GIT_COMMIT=
# URL interne de la façade Python lue par le web (le navigateur passe par /api) [prod]
API_INTERNAL_URL=http://127.0.0.1:3001

# --- Supabase (base, authentification, stockage) ----------------------------
# Valeurs affichées par `supabase start` en local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- IA (ADR-0018 à 0022, 0048) ---------------------------------------------
# Autorise les modèles locaux (Ollama, LM Studio) comme modèles personnels (SPEC-505)
ALLOW_LOCAL_MODELS=false
# Embeddings (ADR-0056) [prod]
VOYAGE_API_KEY=
# Recherche web de repli pour les fournisseurs sans outil natif (Tavily, ADR-0048)
SEARCH_API_KEY=

# --- E-mails (Resend, ADR-0054) ---------------------------------------------
# Le transport est dérivé d'APP_ENV et de SMTP_HOST : memory en test, SMTP si
# SMTP_HOST est renseigné, Resend sinon. Le port SMTP est la constante 1025.
SMTP_HOST=127.0.0.1
# Adresse d'expédition [prod] ; une adresse nue reçoit le nom affiché « Learny »
EMAIL_FROM=bonjour@learny.local
RESEND_API_KEY=

# --- Paiement (Stripe, ADR-0061) --------------------------------------------
# Le mode (mock | test | live) est dérivé de STRIPE_SECRET_KEY côté Python [prod].
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observabilité (ADR-0043, facultative) ----------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Tests et preuves SDD ---------------------------------------------------
# Horloge figée (ADR-0047) : vide = horloge réelle. En e2e : 2026-11-11T12:20:00Z
CLOCK_FIXED_AT=
# Pages de démonstration /_dev/* (ADR-0049) ; seul `true` active le garde, et la
# production refuse le démarrage si ce n'est pas `false`.
ENABLE_SDD_PAGES=true
# Outillage de test (hors schéma applicatif) : seul `mock` est accepté (ADR-0048)
LLM_MODE=mock
# API de Mailpit des tests d authentification ; vide = celle de `supabase status`
MAILPIT_URL=
# Client de base des tests (packages/testing) : taille du pool et journal SQL
DATABASE_POOL_MAX=10
DB_LOG_QUERIES=false
# Pousse sur origin après chaque fusion si le remote existe (ADR-0051) : 1 | 0
SDD_PUSH=1
# 1 = ne pas reconstruire avant les e2e (SPEC-004)
E2E_SKIP_BUILD=0
# Chromium utilisé par Lighthouse ; vide = celui de Playwright (SPEC-804)
CHROME_PATH=

# --- Déploiement (SPEC-013) — secrets GitHub Actions, jamais dans un .env -----
# VERCEL_TOKEN, SUPABASE_ACCESS_TOKEN

# --- Auto-hébergement (SPEC-012) — copier dans .env.selfhost, jamais versionné ---------------
# `cp .env.example .env.selfhost`, remplir les valeurs vides ci-dessous puis suivre
# docs/operations/self-hosting.md. Les valeurs absentes des secrets obligatoires font échouer
# `docker compose config` avant tout démarrage (syntaxe `:?`). Les e-mails partent vers Mailpit.
# URLs publiques de cette installation (navigateur) — distinctes des valeurs locales ci-dessus :
LEARNY_PUBLIC_APP_URL=
LEARNY_PUBLIC_SUPABASE_URL=
# Ports publiés sur l'hôte (les autres services restent sur le réseau interne) :
LEARNY_WEB_PORT=8080
LEARNY_SUPABASE_PORT=8000
LEARNY_MAILPIT_SMTP_PORT=1025
LEARNY_MAILPIT_UI_PORT=8025
# Mot de passe du rôle postgres et secret de signature des JWT Supabase (générés, vides ici) :
POSTGRES_PASSWORD=
SUPABASE_JWT_SECRET=
# Clés anon/service signées avec SUPABASE_JWT_SECRET (générées par tools/docker/selfhost-secrets.mjs) :
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Clé maîtresse (générée) : les secrets internes en sont dérivés.
APP_ENCRYPTION_KEY=
# Identité du build, identique pour web et API (GIT_COMMIT=$(git rev-parse HEAD)).
GIT_COMMIT=
APP_VERSION=
