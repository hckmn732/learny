{
  "name": "learny",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "analyze": "ANALYZE=true pnpm --filter @learny/web build",
    "build": "turbo run build",
    "ci:check": "node tools/ci/check-workflows.mjs",
    "contract:check": "tsx packages/contracts/scripts/export-contract.ts --check",
    "contract:export": "tsx packages/contracts/scripts/export-contract.ts",
    "db:check": "pnpm --filter @learny/db check",
    "db:generate": "pnpm --filter @learny/db generate",
    "db:migrate": "supabase migration up --local",
    "db:migration:custom": "pnpm --filter @learny/db migration:custom",
    "db:reset": "node tools/dev/db-reset.mjs",
    "db:seed:demo": "node tools/dev/db-seed-demo.mjs",
    "deploy:check": "node tools/deploy/check.mjs",
    "deploy:migrate": "node tools/deploy/migrate.mjs",
    "design:references": "node tools/design/capture-references.mjs",
    "design:references:check": "node tools/design/check-references.mjs",
    "dev": "turbo run dev --filter=@learny/web",
    "dev:check": "node tools/dev/check.mjs",
    "dev:down": "node tools/dev/down.mjs",
    "dev:up": "node tools/dev/up.mjs",
    "docker:check:selfhost": "node tools/docker/check-selfhost.mjs",
    "docker:secrets:selfhost": "node tools/docker/selfhost-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "legal:check": "node tools/legal/check.mjs",
    "lint": "turbo run lint && pnpm run lint:root && pnpm run db:check && pnpm run openapi:check && node tools/migration/report.mjs --check && pnpm run contract:check && pnpm run sdk:check && pnpm run py:lint && pnpm run py:contract:check && pnpm run rls:check",
    "lint:root": "eslint --max-warnings=0 tools *.config.ts *.config.mjs",
    "migration:report": "node tools/migration/report.mjs",
    "openapi:check": "tsx packages/contracts/scripts/generate-openapi.ts --check",
    "openapi:generate": "tsx packages/contracts/scripts/generate-openapi.ts",
    "parity:check": "tsx tools/parity/run.ts --check",
    "parity:record": "tsx tools/parity/run.ts --record",
    "perf:seed": "tsx packages/testing/src/db/seed/perf-cli.ts",
    "prepare": "husky",
    "py:contract:check": "node tools/contract/generate-py-contract.mjs --check",
    "py:contract:generate": "node tools/contract/generate-py-contract.mjs",
    "py:lint": "uv run ruff format --check . && uv run ruff check . && uv run lint-imports",
    "py:sync": "uv sync --frozen",
    "py:test:unit": "uv run pytest packages-py apps",
    "py:typecheck": "uv run mypy packages-py apps",
    "quality:journeys": "node tools/quality/check-v1-journeys.mjs",
    "rls:check": "tsx packages/db/scripts/export-rls-matrix.ts --check",
    "rls:export": "tsx packages/db/scripts/export-rls-matrix.ts",
    "sdd:adr": "node tools/sdd/adr.mjs",
    "sdd:audit": "node tools/sdd/audit.mjs",
    "sdd:checkpoint": "node tools/sdd/checkpoint.mjs",
    "sdd:complete": "node tools/sdd/complete.mjs",
    "sdd:fail": "node tools/sdd/fail.mjs",
    "sdd:next": "node tools/sdd/next.mjs",
    "sdd:start": "node tools/sdd/start.mjs",
    "sdd:status": "node tools/sdd/status.mjs",
    "sdd:validate": "node tools/sdd/validate.mjs",
    "sdk:check": "node tools/contract/generate-sdk.mjs --check",
    "sdk:generate": "node tools/contract/generate-sdk.mjs",
    "test:e2e": "node apps/web/e2e/run-playwright.mjs",
    "test:int": "vitest run --project integration",
    "test:perf": "node tools/perf/run.mjs",
    "test:related": "node tools/dev/test-related.mjs",
    "test:unit": "vitest run --project unit",
    "test:v1:journeys": "node apps/web/e2e/run-playwright.mjs --project=journeys --project=journeys-firefox --project=journeys-webkit",
    "test:visual": "node apps/web/e2e/run-playwright.mjs --grep @visual",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json --noEmit && pnpm run py:typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@learny/testing": "workspace:*",
    "@lhci/cli": "^0.16.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.0",
    "@readme/openapi-parser": "^10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-validate": "^11.21.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "web-vitals": "^5.3.0",
    "yaml": "^2.9.1"
  }
}
