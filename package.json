{
  "name": "learny",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --filter=@learny/web",
    "dev:up": "node tools/dev/up.mjs",
    "dev:down": "node tools/dev/down.mjs",
    "dev:check": "node tools/dev/check.mjs",
    "docker:check:selfhost": "node tools/docker/check-selfhost.mjs",
    "docker:secrets:selfhost": "node tools/docker/selfhost-secrets.mjs",
    "db:reset": "node tools/dev/db-reset.mjs",
    "db:seed:demo": "node tools/dev/db-seed-demo.mjs",
    "db:generate": "pnpm --filter @learny/db generate",
    "db:migration:custom": "pnpm --filter @learny/db migration:custom",
    "db:migrate": "supabase migration up --local",
    "db:check": "pnpm --filter @learny/db check",
    "dev:worker": "turbo run dev --filter=@learny/worker",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run lint:root && pnpm run db:check && pnpm run openapi:check",
    "lint:root": "eslint --max-warnings=0 tools *.config.ts *.config.mjs",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "node apps/web/e2e/run-playwright.mjs",
    "test:visual": "node apps/web/e2e/run-playwright.mjs --grep @visual",
    "ci:check": "node tools/ci/check-workflows.mjs",
    "deploy:check": "node tools/deploy/check.mjs",
    "deploy:migrate": "node tools/deploy/migrate.mjs",
    "deploy:sync": "node tools/deploy/sync-inngest.mjs",
    "design:references": "node tools/design/capture-references.mjs",
    "design:references:check": "node tools/design/check-references.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdd:next": "node tools/sdd/next.mjs",
    "sdd:status": "node tools/sdd/status.mjs",
    "sdd:start": "node tools/sdd/start.mjs",
    "sdd:validate": "node tools/sdd/validate.mjs",
    "sdd:complete": "node tools/sdd/complete.mjs",
    "sdd:fail": "node tools/sdd/fail.mjs",
    "sdd:checkpoint": "node tools/sdd/checkpoint.mjs",
    "sdd:audit": "node tools/sdd/audit.mjs",
    "sdd:adr": "node tools/sdd/adr.mjs",
    "openapi:generate": "tsx packages/contracts/scripts/generate-openapi.ts",
    "openapi:check": "tsx packages/contracts/scripts/generate-openapi.ts --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/lint": "^21.2.4",
    "@commitlint/load": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.0",
    "@readme/openapi-parser": "^10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "next-test-api-route-handler": "^5.0.7",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
